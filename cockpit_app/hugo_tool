    $d = rtrim($in, '/') . '/' . $nm; if (file_exists($d)) fail("new: $d already exists, nothing was changed"); foreach (['content/posts', 'layouts/_default', 'layouts/partials', 'static', 'archetypes'] as $x) mkdir("$d/$x", 0775, true);
    file_put_contents("$d/hugo.toml", "baseURL = 'https://example.org/'\nlocale = 'en'\ntitle = '$nm'\n[params]\n  description = 'A small site made with Hugo.'\n");
    file_put_contents("$d/archetypes/default.md", "+++\ntitle = '{{ replace .File.ContentBaseName \"-\" \" \" | title }}'\ndate = {{ .Date }}\ndraft = true\n+++\n");
    file_put_contents("$d/content/_index.md", "+++\ntitle = 'Home'\n+++\n\nWelcome. This site is plain Hugo with its own small layouts: no theme to download.\n");
    file_put_contents("$d/content/posts/first-post.md", "+++\ntitle = 'First post'\ndate = 2026-01-05T10:00:00Z\ndraft = false\n+++\n\nThe first post. Some **bold** text and a [link](/posts/second-post/).\n");
