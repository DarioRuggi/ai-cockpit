    file_put_contents("$d/layouts/_default/single.html", "{{ define \"main\" }}\n<article>\n  <h1>{{ .Title }}</h1>\n  <p><small>{{ .Date.Format \"2006-01-02\" }}</small></p>\n  {{ .Content }}\n</article>\n{{ end }}\n");
