// ---- STL analysis (no OpenSCAD needed) ---------------------------------------------------------------------------------------------------------
/** [[x,y,z],[x,y,z],[x,y,z]] per triangle, from an ASCII or binary STL */
function read_stl(string $f): array {
    $b = (string)file_get_contents($f); $n = strlen($b); $tris = [];
    if ($n >= 84) { $cnt = unpack('V', substr($b, 80, 4))[1]; if (84 + 50 * $cnt === $n) { for ($i = 0; $i < $cnt; $i++) { $v = unpack('f9', substr($b, 84 + 50 * $i + 12, 36)); $tris[] = [[$v[1], $v[2], $v[3]], [$v[4], $v[5], $v[6]], [$v[7], $v[8], $v[9]]]; } return $tris; } }
    if (preg_match_all('/vertex\s+(\S+)\s+(\S+)\s+(\S+)/', $b, $m, PREG_SET_ORDER)) { for ($i = 0; $i + 2 < count($m); $i += 3) $tris[] = [[(float)$m[$i][1], (float)$m[$i][2], (float)$m[$i][3]], [(float)$m[$i + 1][1], (float)$m[$i + 1][2], (float)$m[$i + 1][3]], [(float)$m[$i + 2][1], (float)$m[$i + 2][2], (float)$m[$i + 2][3]]]; }
    return $tris;
}
function mesh_stats(array $tris): array {
