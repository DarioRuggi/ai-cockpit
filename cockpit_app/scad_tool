#!/usr/bin/env php
<?php
// =============================================================================
// scad_tool — the 3D printing / CAD tools' work, for the tool presets (tools_builtins/scad.json). A command-line program, never reachable over the web.
//
//   php scad_tool check  FILE.scad OUTPUT            compile in a sandbox; errors and warnings as file(line), the model's size and whether it is a valid solid, then [exit code N]
//   php scad_tool stl    FILE.scad OUTPUT.stl|3mf|off   the model exported
//   php scad_tool png    FILE.scad OUTPUT.png        a picture of the model (rendered without a screen)
//   php scad_tool info   FILE.stl|FILE.scad OUTPUT   triangles, bounding box in mm, volume, surface area, and whether the mesh is watertight (a .scad is compiled first)
//   php scad_tool print  FILE.stl|FILE.scad OUTPUT [bed=220x220x250]   will it print: fits the bed, watertight, how much overhangs (needs supports), tiny dimensions
//   php scad_tool params FILE.scad OUTPUT            the top-level parameters (name, value, comment) that the model is built from
//   php scad_tool new    FOLDER OUTPUT NAME          a parametric part NAME.scad; never overwrites
//
// SAFETY: OpenSCAD can read any file the account can (include, import, surface, text files), so every run happens inside bubblewrap: no network, no home folder, a read-only system,
