    $root = dirname($in); $size = 0; foreach (new DirectoryIterator($root) as $f) { if ($f->isDot() || $f->isLink() || $f->isDir()) continue; if (!preg_match('/\.(scad|stl|dxf|svg|png|csv|json|txt|off|3mf|amf)$/i', $f->getFilename())) continue; $size += $f->getSize(); if ($size > 50 * 1048576) fail('the folder holds more than 50 MB of model files'); copy($f->getPathname(), "$tmp/work/" . $f->getFilename()); }
    foreach (['lib', 'libs', 'modules', 'include'] as $d) if (is_dir("$root/$d") && !is_link("$root/$d")) { @mkdir("$tmp/work/$d"); foreach (new DirectoryIterator("$root/$d") as $f) if (!$f->isDot() && $f->isFile() && !$f->isLink() && $f->getSize() < 5 * 1048576) copy($f->getPathname(), "$tmp/work/$d/" . $f->getFilename()); }
    $bw = 'bwrap --unshare-all --die-with-parent --new-session --ro-bind /usr /usr --symlink usr/lib /lib --symlink usr/lib64 /lib64 --symlink usr/bin /bin --symlink usr/sbin /sbin --ro-bind-try /etc/fonts /etc/fonts --ro-bind-try /etc/ld.so.cache /etc/ld.so.cache --ro-bind-try /etc/alternatives /etc/alternatives --ro-bind-try /var/cache/fontconfig /var/cache/fontconfig --proc /proc --dev /dev --tmpfs /tmp --bind ' . escapeshellarg("$tmp/work") . ' /work --chdir /work --setenv HOME /tmp --setenv PATH /usr/bin:/bin --setenv LANG C.UTF-8 --setenv LC_ALL C.UTF-8 ';
    return [$tmp, $bw];
}
function run_openscad(string $bw, string $outName, string $mainName, int $secs = 240, string $extra = '', bool $xvfb = false): array {
    $rc = 0; $cmd = 'timeout ' . $secs . ' ' . $bw . ($xvfb ? 'xvfb-run -a ' : '') . 'openscad ' . $extra . ' -o /work/' . escapeshellarg($outName) . ' ' . escapeshellarg($mainName); $o = sh($cmd, $rc); return [$rc, $o];
}
/** errors/warnings from OpenSCAD's text: [[kind, file, line, message]] and the geometry facts */
function parse_log(string $log, string $main): array {
    $res = ['msgs' => [], 'facts' => []];
    foreach (explode("\n", $log) as $l) {
        if (preg_match('/^(ERROR|WARNING|DEPRECATED):\s*(.*?)(?:,? in file ([^,]+),? line (\d+))?\s*$/', $l, $m)) { $k = $m[1] === 'ERROR' ? 'Error' : 'Warning'; $res['msgs'][] = [$k, isset($m[3]) && $m[3] !== '' ? basename($m[3]) : $main, isset($m[4]) ? (int)$m[4] : 1, trim($m[2])]; }
        elseif (preg_match('/^\s*(Simple|Vertices|Facets|Volumes|Top level object is a)\s*:?\s*(.*)$/', $l, $m)) $res['facts'][$m[1]] = trim($m[2]);
    }
    return $res;
}
function report_mesh(array $s, string $title, array &$warn, ?array $bed = null): string {
    $dx = $s['max'][0] - $s['min'][0]; $dy = $s['max'][1] - $s['min'][1]; $dz = $s['max'][2] - $s['min'][2];
    $o = "- Triangles: {$s['n']}; vertices: {$s['verts']}\n- Bounding box: " . round($dx, 2) . ' x ' . round($dy, 2) . ' x ' . round($dz, 2) . " mm (from " . implode(', ', array_map(fn($x) => round($x, 2), $s['min'])) . ")\n- Volume: " . round($s['vol'] / 1000, 3) . " cm³ (" . round($s['vol'], 1) . " mm³); surface area: " . round($s['area'] / 100, 2) . " cm²\n- Watertight: " . (($s['open'] === 0 && $s['over'] === 0) ? 'yes' : "NO ({$s['open']} open edge(s), {$s['over']} edge(s) shared by more than two triangles)") . "\n";
    if ($s['open'] > 0 || $s['over'] > 0) $warn[] = 'the mesh is not watertight (' . $s['open'] . ' open edges, ' . $s['over'] . ' non-manifold): slicers may refuse it or print holes';
    if ($s['deg'] > 0) $warn[] = $s['deg'] . ' degenerate (zero-area) triangle(s)'; if ($s['neg']) $warn[] = 'the triangles face inwards (negative volume): the model is inside out';
    if ($dz > 0 && $s['area'] > 0) { $pct = round(100 * $s['down'] / $s['area'], 1); $o .= "- Overhang: $pct% of the surface faces more than 45° downward (needs supports unless it is the bottom face)\n"; }
