if (in_array($sub, ['info', 'print'], true) && $ext === 'stl') {
    $tris = read_stl($in); if (!$tris) fail('no triangles found: not a readable STL');
    $s = mesh_stats($tris); $warn = []; $o = ($sub === 'info' ? "# Mesh: " : "# Printability: ") . basename($in) . "\n\n" . report_mesh($s, basename($in), $warn);
