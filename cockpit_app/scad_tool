$o .= "\n## Will it print? (bed {$bed[0]} x {$bed[1]} x {$bed[2]} mm)\n\n" . ($lines ? implode("\n", $lines) . "\n" : "Nothing found against a {$bed[0]}x{$bed[1]}x{$bed[2]} bed: it fits, it is watertight, and it has no thin parts or large overhangs.\n") . "\nThis is arithmetic on the mesh, not a slicer: layer height, nozzle and material decide the rest.\n";
file_put_contents($out, $o . "\n[exit code " . ($ne > 0 ? 1 : 0) . "]\n"); echo "Wrote $out ($ne errors, $nw warnings)\n";
