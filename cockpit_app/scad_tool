    $o = ($sub === 'info' ? "# Mesh of " : "# Printability of ") . $main . " (compiled in a sandbox)\n\n" . report_mesh($s, $main, $warn); $warn = array_filter($warn, fn($w) => !preg_match('/^\S+\(\d+\) /', $w)) + array_filter($warn, fn($w) => preg_match('/^\S+\(\d+\) /', $w));
}
if ($sub === 'info') { file_put_contents($out, $o . "\n[exit code 0]\n"); echo "Wrote $out\n"; exit(0); }
// print
$dx = $s['max'][0] - $s['min'][0]; $dy = $s['max'][1] - $s['min'][1]; $dz = $s['max'][2] - $s['min'][2]; $bed = [220, 220, 250]; if (!empty($opt['bed']) && preg_match('/^(\d+)x(\d+)x(\d+)$/', $opt['bed'], $m)) $bed = [(int)$m[1], (int)$m[2], (int)$m[3]]; elseif (!empty($opt['bed'])) fail('bed must look like 220x220x250 (mm)');
$lines = []; $b = basename($in);
