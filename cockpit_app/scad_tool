    $vid = function (array $p) use (&$ids): int { $k = round($p[0], 4) . ',' . round($p[1], 4) . ',' . round($p[2], 4); return $ids[$k] ??= count($ids); };
    foreach ($tris as [$a, $b, $c]) { for ($i = 0; $i < 3; $i++) foreach ([$a, $b, $c] as $p) { $min[$i] = min($min[$i], $p[$i]); $max[$i] = max($max[$i], $p[$i]); }
        $vol += ($a[0] * ($b[1] * $c[2] - $b[2] * $c[1]) - $a[1] * ($b[0] * $c[2] - $b[2] * $c[0]) + $a[2] * ($b[0] * $c[1] - $b[1] * $c[0])) / 6;
        $u = [$b[0] - $a[0], $b[1] - $a[1], $b[2] - $a[2]]; $v = [$c[0] - $a[0], $c[1] - $a[1], $c[2] - $a[2]]; $nx = $u[1] * $v[2] - $u[2] * $v[1]; $ny = $u[2] * $v[0] - $u[0] * $v[2]; $nz = $u[0] * $v[1] - $u[1] * $v[0]; $len = sqrt($nx * $nx + $ny * $ny + $nz * $nz); $ar = $len / 2; $area += $ar;
        if ($ar < 1e-9) { $deg++; continue; } if ($nz / $len < -0.7071 && $a[2] > $min[2] + 0.0) $down += $ar;      // faces looking more than 45 degrees downward
        $ia = $vid($a); $ib = $vid($b); $ic = $vid($c); foreach ([[$ia, $ib], [$ib, $ic], [$ic, $ia]] as [$p, $q]) { $k = $p < $q ? "$p:$q" : "$q:$p"; $edges[$k] = ($edges[$k] ?? 0) + 1; } }
    $open = 0; $over = 0; foreach ($edges as $c) { if ($c === 1) $open++; elseif ($c > 2) $over++; }
    return ['n' => count($tris), 'min' => $min, 'max' => $max, 'vol' => abs($vol), 'neg' => $vol < 0, 'area' => $area, 'deg' => $deg, 'open' => $open, 'over' => $over, 'down' => $down, 'verts' => count($ids)];
}

// ---- the sandbox ------------------------------------------------------------------------------------------------------------------------------
$tmp = null; $box = null; $main = null;
function start_box(string $in): array {
    if (!have('bwrap')) fail("bwrap (bubblewrap) is not installed, and OpenSCAD is not run without it: a model can read any file this account can (include, import, surface). Install it: sudo apt install bubblewrap");
