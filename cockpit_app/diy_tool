        if ($q === null) { $msgs[] = "$name($l) Error: the quantity \"" . ($c[$cq] ?? '') . '" cannot be read'; $errs++; continue; } if ($p === null) { $msgs[] = "$name($l) Error: the price \"" . ($c[$cp] ?? '') . '" cannot be read'; $errs++; continue; }
