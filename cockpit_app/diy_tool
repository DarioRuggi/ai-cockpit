            if (!$l || !$w || !$dp || $l <= 0 || $w <= 0 || $dp <= 0) $bad('give length=, width= and depth= above zero (metres, or with a suffix such as depth=10cm)'); elseif ($waste === null || $waste < 0 || $waste > 100) $bad('waste= must be a percentage between 0 and 100');
            else { $v = $l * $w * $dp; $vw = $v * (1 + $waste / 100); $sec = '- Volume: ' . fmt($l) . ' x ' . fmt($w) . ' x ' . fmt($dp, 3) . ' m = ' . fmt($v, 3) . " m3\n- With $waste% waste and spillage: **" . fmt($vw, 3) . " m3** (" . fmt($vw * 1000, 0) . " litres)\n"; if (isset($k['bag'])) { $b = num($k['bag']); if ($b === null || $b <= 0) $bad('bag= must be the m3 one bag makes'); else $sec .= '- At ' . fmt($b, 4) . " m3 per bag (your figure, from the bag): **" . (int)ceil($vw / $b - 1e-9) . " bags**\n"; } else $sec .= "- Add bag=M3 (the yield printed on the bag) to count bags; a yield is not assumed here. Ready-mix is sold by the m3.\n"; }
