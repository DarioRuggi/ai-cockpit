[$H, $R] = read_csv($in); if (!$R) fail('the schedule has no rows under the header');
$ct = find_col($H, ['task', 'item', 'description', 'name', 'job', 'tâche', 'tarea', 'compito', 'aufgabe', 'tarefa']); $cl = find_col($H, ['last done', 'last', 'done', 'last service', 'date', 'última', 'dernier', 'zuletzt', 'ultimo', 'último', 'last date']); $cv = find_col($H, ['interval', 'every', 'frequency', 'cycle', 'intervalo', 'intervalle', 'intervall', 'intervallo', 'periodicity']);
if ($cl === null || $cv === null) fail('the schedule needs a last-done date column and an interval column (6 months, 1 year, 90 days, 2 weeks)');
$today = $opt['today'] ?? date('Y-m-d'); if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $today) || !checkdate((int)substr($today, 5, 2), (int)substr($today, 8, 2), (int)substr($today, 0, 4))) fail('today= must be a date like 2026-03-01'); $within = isset($opt['within']) && ctype_digit($opt['within']) ? (int)$opt['within'] : 30;
