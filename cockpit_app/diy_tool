            if ($e === null) { $ceil = $ceil ?? 0; $open = $doors * $da + $wins * $wa; $net = $area - $open; if ($net <= 0) $bad('the doors and windows (' . fmt($open) . ' m2) take up all the wall area'); else { $tot = $net + $ceil; $lit = $tot * $coats / $cov;
                $sec = "- Wall area: $desc\n- Minus $doors door(s) at " . fmt($da) . " m2 and $wins window(s) at " . fmt($wa) . " m2: " . fmt($net) . " m2 to paint\n" . ($ceil > 0 ? '- Plus the ceiling: ' . fmt($ceil) . " m2\n" : '') . "- $coats coat(s) at " . fmt($cov) . " m2 per litre (your coverage figure; the tin says the real one, and rough or dark surfaces take more)\n- **Paint needed: " . fmt($lit) . " litres**; buy at least " . fmt(ceil($lit * 2) / 2, 1) . " litres (rounded up to the next half litre), more for a first coat on bare plaster\n"; } }
        } elseif ($kind === 'floor' || $kind === 'tile') {
