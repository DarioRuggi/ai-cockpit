    $dt = new DateTime($ld); $whole = (int)floor($nq); $dt->modify('+' . ($unit === 'week' ? $whole * 7 : $whole) . ' ' . ($unit === 'week' ? 'days' : $unit . 's')); if ($nq != $whole) { if ($unit === 'year') $dt->modify('+' . (int)round(($nq - $whole) * 12) . ' months'); elseif ($unit === 'month') $dt->modify('+' . (int)round(($nq - $whole) * 30) . ' days'); elseif ($unit === 'week') $dt->modify('+' . (int)round(($nq - $whole) * 7) . ' days'); }
