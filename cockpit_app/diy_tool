function dmy_guess(array $rows, ?int $c): bool { if ($c === null) return true; $a1 = 0; $a2 = 0; foreach ($rows as $r) if (preg_match('/^(\d{1,2})[\/.\-](\d{1,2})[\/.\-]\d{2,4}/', trim($r['cells'][$c] ?? ''), $m)) { if ((int)$m[1] > 12) $a1++; if ((int)$m[2] > 12) $a2++; } return !($a2 > 0 && $a1 === 0); }
function money(float $v): string { return number_format($v, 2, '.', ','); }

const SAFE = "Electrical, gas, structural, roof, chimney, asbestos and similar work belongs to licensed professionals and to your local rules: this tool does arithmetic only.";
const RISKY = 'electric|wiring|rewir|socket|fuse|gas\b|boiler|furnace|load.?bearing|structur|chimney|roof|asbestos|plumbing|sewer|elektr|câblage|cablage|électri|electri|cableado|cavi|impianto|gaz\b|chaudière|caldaia|caldera|heizung|dach|toit|tetto|tejado|telhado|amiante|amianto|asbest|structure|tragend|portante|portador';
function text_file(string $f): string { if (!is_file($f)) fail("no such file: $f"); $t = (string)file_get_contents($f); if (strncmp($t, "\xEF\xBB\xBF", 3) === 0) $t = substr($t, 3); if (!mb_check_encoding($t, 'UTF-8')) fail('the file is not UTF-8 text: ' . basename($f)); if (trim($t) === '') fail('the file is empty: ' . basename($f)); return $t; }
function num(string $s): ?float { $s = trim($s); if (!preg_match('/^[-+]?\d+(?:[.,]\d+)?$/', $s)) return null; return (float)str_replace(',', '.', $s); }
/** a length in metres from "2.4", "240cm", "8ft", "3 in"; $def = the unit when none is written */
function len(string $s, string $def = 'm'): ?float { if (!preg_match('/^\s*([-+]?\d+(?:[.,]\d+)?)\s*(mm|cm|m|in|inch|inches|"|ft|feet|\')?\s*$/i', $s, $m)) return null; $u = strtolower($m[2] ?? '') ?: $def; $v = (float)str_replace(',', '.', $m[1]); return $v * ['mm' => 0.001, 'cm' => 0.01, 'm' => 1, 'in' => 0.0254, 'inch' => 0.0254, 'inches' => 0.0254, '"' => 0.0254, 'ft' => 0.3048, 'feet' => 0.3048, "'" => 0.3048][$u]; }
function dims(string $s, string $def): ?array { $s = trim($s); $sfx = ''; if (preg_match('/(mm|cm|m|in|ft)$/i', $s, $m)) { $sfx = strtolower($m[1]); $s = substr($s, 0, -strlen($m[1])); } $p = preg_split('/\s*[x×*]\s*/u', $s); $u = $sfx ?: $def; $o = []; foreach ($p as $x) { $v = len($x . $u, $u); if ($v === null || $v <= 0) return null; $o[] = $v; } return $o; }
function fmt(float $v, int $d = 2): string { return number_format($v, $d, '.', ','); }
function kv(string $s): array { $o = []; preg_match_all('/([A-Za-z_]+)\s*=\s*("[^"]*"|\S+)/u', $s, $m, PREG_SET_ORDER); foreach ($m as $x) $o[strtolower($x[1])] = trim($x[2], '"'); return $o; }
$name = basename($in); $msgs = [];

if ($sub === 'calc') {
    $o = "# Material calculations: $name\n\n"; $errs = 0; $n = 0; $ln = 0;
    foreach (preg_split('/\n/', str_replace("\r", '', text_file($in))) as $line) { $ln++; $line = trim($line); if ($line === '' || $line[0] === '#') continue; $n++;
        if (!preg_match('/^([A-Za-z]+)\s*:\s*(.*)$/u', $line, $m)) { $msgs[] = "$name($ln) Error: expected \"kind: key=value ...\" (kind is paint, floor, concrete or lumber)"; $errs++; continue; }
        $kind = strtolower($m[1]); $k = kv($m[2]); $e = null; $sec = ''; $bad = function (string $t) use (&$e) { $e = $t; };
        if (preg_match('/' . RISKY . '/iu', $line)) $msgs[] = "$name($ln) Note: this line mentions work that needs a licensed professional (see the safety note).";
        if ($kind === 'paint') {
            $coats = isset($k['coats']) ? num($k['coats']) : 2.0; $cov = isset($k['coverage']) ? num($k['coverage']) : 10.0; $doors = isset($k['doors']) ? num($k['doors']) : 0.0; $wins = isset($k['windows']) ? num($k['windows']) : 0.0; $da = isset($k['doorarea']) ? num($k['doorarea']) : 1.6; $wa = isset($k['windowarea']) ? num($k['windowarea']) : 1.2;
            if ($coats === null || $coats < 1 || $cov === null || $cov <= 0 || $doors === null || $wins === null || $da === null || $wa === null) $bad('coats, coverage, doors, windows, doorarea and windowarea must be numbers (coverage above zero)');
