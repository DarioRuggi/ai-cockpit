            $stocks = []; if ($e === null) foreach (array_filter(array_map('trim', explode(',', $k['stock'] ?? ''))) as $x) { $v = len($x); if ($v === null || $v <= 0) { $bad("the length \"$x\" in stock= cannot be read"); break; } $stocks[] = $v; }
            $kerf = isset($k['kerf']) ? num($k['kerf']) : 3.0; if ($e === null && (!$need || !$stocks)) $bad('give need=2.4,1.8,... and stock=2.4,3.0 (lengths in metres, or with a suffix)'); if ($e === null && ($kerf === null || $kerf < 0)) $bad('kerf= must be the saw cut in mm');
            if ($e === null) { rsort($need); $sec = '- Needed: ' . count($need) . ' pieces, ' . fmt(array_sum($need)) . " m in all; saw cut $kerf mm (first-fit decreasing: a good plan, not always the very best possible)\n"; $kf = $kerf / 1000; $best = null;
                foreach (array_unique($stocks) as $st) { if ($need[0] > $st + 1e-9) { $sec .= '- Stock ' . fmt($st) . " m: cannot be used, the longest piece needed is " . fmt($need[0]) . " m\n"; continue; } $bins = []; foreach ($need as $p) { $placed = false; foreach ($bins as &$b) if ($b['left'] + 1e-9 >= $p + ($b['cuts'] ? $kf : 0)) { $b['left'] -= $p + ($b['cuts'] ? $kf : 0); $b['cuts'][] = $p; $placed = true; break; } unset($b); if (!$placed) $bins[] = ['left' => $st - $p, 'cuts' => [$p]]; }
