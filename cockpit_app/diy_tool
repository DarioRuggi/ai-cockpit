    $nq = (float)str_replace(',', '.', $im[1]); $u = mb_strtolower($im[2]); $unit = preg_match('/^(d|day|jour|tag|giorn|dia)/u', $u) ? 'day' : (preg_match('/^(w|sem|woch|settim)/u', $u) ? 'week' : (preg_match('/^(y|an|jahr|ann|año|ano)/u', $u) ? 'year' : 'month'));
