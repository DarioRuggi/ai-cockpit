$rows = []; $errs = 0; $warn = 0; $over = []; $soon = []; $never = [];
foreach ($R as $r) { $c = $r['cells']; $l = $r['line']; $task = trim($c[$ct ?? 0] ?? ''); $rd = trim($c[$cl] ?? ''); $ri = trim($c[$cv] ?? '');
    if (preg_match('/' . RISKY . '/iu', $task)) $msgs[] = "$name($l) Note: \"$task\" is work for a licensed professional (see the safety note).";
