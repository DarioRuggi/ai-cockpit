        $kind = preg_match('/labou?r|hour|work|service|install|fitting|arbeit|stunde|main.?d|travail|heure|mano|obra|lavoro|ore\b|trabalho|hora|horas|mão/iu', $ty . ' ' . ($H[$cq] ?? '')) ? 'labour' : (preg_match('/part|material|suppl|goods|pièce|piece|matériel|materiel|teil|ware|pieza|materiale|pezzo|peça|material/iu', $ty) ? 'part' : null);
        if ($kind === null) { $kind = 'part'; $unk++; $msgs[] = "$name($l) Note: the type \"$ty\" is not part or labour: counted as a part"; }
