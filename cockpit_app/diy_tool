            elseif (isset($k['area'])) { $area = num($k['area']); if ($area === null || $area <= 0) $bad('area= must be a number of m2, above zero'); }
            elseif (isset($k['room'])) { $d = dims($k['room'], 'm'); if (!$d || count($d) !== 2) $bad('room= must be length x width, e.g. room=4x3 (metres)'); else $area = $d[0] * $d[1]; } else $bad('give area=M2 or room=LxW');
            if ($e === null) { $need = $area * (1 + $waste / 100); $sec = "- Floor area: " . fmt($area) . " m2; with $waste% waste: " . fmt($need) . " m2 to buy (" . ($waste == 10 && !isset($k['waste']) ? 'the default 10%: cuts, breakage and a spare; diagonal laying or patterns need more' : 'your figure') . ")\n";
                if (isset($k['piece'])) { $d = dims($k['piece'], 'cm'); if (!$d || count($d) !== 2) $bad('piece= must be width x length, e.g. piece=30x30 (cm by default)'); else { $pa = $d[0] * $d[1]; $cnt = (int)ceil($need / $pa - 1e-9); $sec .= '- One piece is ' . fmt($d[0] * 100, 1) . ' x ' . fmt($d[1] * 100, 1) . ' cm = ' . fmt($pa, 4) . " m2, so **$cnt pieces**\n"; if (isset($k['pack'])) { $pk = num($k['pack']); if ($pk === null || $pk < 1) $bad('pack= must be the number of pieces in a box'); else $sec .= '- Boxes of ' . (int)$pk . ': **' . (int)ceil($cnt / $pk) . " boxes** (" . ((int)ceil($cnt / $pk) * (int)$pk) . " pieces)\n"; } } } else $sec .= "- Add piece=WxL (cm) to get a piece count; boxes cover a fixed area, read it on the box.\n"; }
        } elseif ($kind === 'concrete') {
