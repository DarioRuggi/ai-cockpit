if (!in_array($sub, ['lint', 'info', 'compile', 'cores', 'new'], true) || $in === '' || $out === '') fail('usage: arduino_tool lint|info|compile|cores|new SKETCH OUTPUT [fqbn=...]', 2);
$opt = []; foreach ($args as $a) foreach (preg_split('/[\s;]+(?=\w+=)/', trim($a)) as $p) if (strpos($p, '=') !== false) { [$k, $v] = explode('=', $p, 2); $opt[strtolower(trim($k))] = trim($v); }
