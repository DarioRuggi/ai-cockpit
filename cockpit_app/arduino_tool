#!/usr/bin/env php
<?php
// =============================================================================
// arduino_tool — the Embedded / Arduino tools' work, for the tool presets (tools_builtins/arduino.json). A command-line program, never reachable over the web.
//
//   php arduino_tool lint    SKETCH OUTPUT                 read the sketch (.ino or its folder) and report: no setup()/loop(), Serial used before Serial.begin, digitalWrite with no pinMode,
//                                                          delay() in an interrupt handler, String concatenation in loop(), big global arrays on a small board ... as file(line)
//   php arduino_tool info    SKETCH OUTPUT                 libraries included, pins used, baud rate, functions, interrupt handlers, global memory the arrays take
//   php arduino_tool compile SKETCH OUTPUT fqbn=arduino:avr:uno   compile with arduino-cli: errors as file(line,col), the program and RAM use; if the board's core is not installed it
//                                                          says which core and the ONE command to add it (nothing is downloaded by this tool)
//   php arduino_tool cores   ANY OUTPUT                    the cores (board families) and libraries installed, and how to add one
//   php arduino_tool new     FOLDER OUTPUT NAME            a sketch NAME/NAME.ino (blink + serial); never overwrites
//
// arduino-cli keeps its cores and libraries in ~/.local/share/cockpit/arduino/ (not ~/.arduino15). This tool never downloads anything: adding a core or a library is a command you run.
// The sketch is never changed.
// =============================================================================
if (PHP_SAPI !== 'cli') { http_response_code(403); exit; }
function fail(string $m, int $rc = 1): void { fwrite(STDERR, "arduino_tool: $m\n"); exit($rc); }
