      "key_help": "No key: Cockpit uses the site's own web page in a window you do not see. If the site asks you to log in, its window is shown once; log in there. EXPERIMENTAL: a site can change its page at any time; use the self-test. Check the site's terms before using it this way.",
      "models": [
        {
          "id": "web",
          "label": "Duck.ai (web page)",
          "kinds": [
            "text"
          ],
          "free": true
        }
      ],
      "adapter": {
        "input": [
          "textarea[name=\"user-prompt\"]"
        ],
        "send": [
          "button[type=\"submit\"]"
        ],
        "busy": [
          "button[aria-label*=\"Stop\" i]"
        ],
        "trim": [
          "\\n?2nd opinion[\\s\\S]*$",
          "\\n?Jump to latest response[\\s\\S]*$",
          "\\n?All chats are private[\\s\\S]*$",
          "\\n?Ask anything privately[\\s\\S]*$"
        ],
        "blocked": [
          "verify you are human",
          "just a moment"
        ],
        "stable": 3000,
        "trimStart": [
          "^Duck\\.ai said\\s*\\n[^\\n]*\\n"
        ]
      }
    },
