// unit => [kind, base amount (ml for volume, g for weight)]; names are matched whole, case-insensitively
const UNITS = [
    'tsp' => ['v', 4.92892], 'teaspoon' => ['v', 4.92892], 'teaspoons' => ['v', 4.92892], 'tbsp' => ['v', 14.7868], 'tablespoon' => ['v', 14.7868], 'tablespoons' => ['v', 14.7868], 'tbs' => ['v', 14.7868],
    'cup' => ['v', 236.588], 'cups' => ['v', 236.588], 'pint' => ['v', 473.176], 'pints' => ['v', 473.176], 'quart' => ['v', 946.353], 'quarts' => ['v', 946.353], 'floz' => ['v', 29.5735],
    'ml' => ['v', 1], 'millilitre' => ['v', 1], 'milliliter' => ['v', 1], 'cl' => ['v', 10], 'dl' => ['v', 100], 'l' => ['v', 1000], 'litre' => ['v', 1000], 'litres' => ['v', 1000], 'liter' => ['v', 1000], 'liters' => ['v', 1000],
    'g' => ['w', 1], 'gr' => ['w', 1], 'gram' => ['w', 1], 'grams' => ['w', 1], 'gramme' => ['w', 1], 'grammes' => ['w', 1], 'kg' => ['w', 1000], 'kilo' => ['w', 1000], 'kilogram' => ['w', 1000], 'kilograms' => ['w', 1000], 'mg' => ['w', 0.001],
    'oz' => ['w', 28.3495], 'ounce' => ['w', 28.3495], 'ounces' => ['w', 28.3495], 'lb' => ['w', 453.592], 'lbs' => ['w', 453.592], 'pound' => ['w', 453.592], 'pounds' => ['w', 453.592],
    'clove' => ['c', 0], 'cloves' => ['c', 0], 'can' => ['c', 0], 'cans' => ['c', 0], 'tin' => ['c', 0], 'tins' => ['c', 0], 'slice' => ['c', 0], 'slices' => ['c', 0], 'piece' => ['c', 0], 'pieces' => ['c', 0],
    'pinch' => ['c', 0], 'dash' => ['c', 0], 'bunch' => ['c', 0], 'stick' => ['c', 0], 'sticks' => ['c', 0], 'sprig' => ['c', 0], 'sprigs' => ['c', 0], 'packet' => ['c', 0], 'package' => ['c', 0], 'jar' => ['c', 0], 'head' => ['c', 0],
