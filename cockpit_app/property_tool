const DISCL = "Arithmetic and text checks on what you supplied: not legal, financial, tax or investment advice. Local law decides what a lease, a deposit or a listing must contain; ask a qualified professional.";
function text_file(string $f): string { if (!is_file($f)) fail("no such file: $f"); $t = (string)file_get_contents($f); if (strncmp($t, "\xEF\xBB\xBF", 3) === 0) $t = substr($t, 3); if (!mb_check_encoding($t, 'UTF-8')) fail('the file is not UTF-8 text: ' . basename($f)); if (trim($t) === '') fail('the file is empty: ' . basename($f)); return $t; }
$name = basename($in); $msgs = [];

if ($sub === 'rentroll') {
    [$H, $R] = read_csv($in); if (!$R) fail('the rent roll has no rows under the header');
    $HX = array_map(fn($h) => preg_match('/due|paid|end|expir|deposit|fin|ende|scad|venc/iu', $h) ? '' : $h, $H);
