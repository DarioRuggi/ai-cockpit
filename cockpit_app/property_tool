    $days = fn($d) => (int)round((strtotime($d) - strtotime($today)) / 86400); $over = []; $up = []; $ends = []; $ended = []; $dep = []; $nodep = []; $errs = 0; $warn = 0; $seen = []; $paidN = 0; $partial = [];
    foreach ($R as $r) { $c = $r['cells']; $l = $r['line']; $unit = trim($c[$cU ?? 0] ?? ''); $ten = $cT !== null ? trim($c[$cT] ?? '') : ''; $who = $unit . ($ten !== '' ? " ($ten)" : ''); $cur = $cC !== null ? strtoupper(trim($c[$cC] ?? '')) : ''; $rent = parse_num($c[$cR] ?? '');
        if ($rent === null) { $msgs[] = "$name($l) Error: the rent \"" . ($c[$cR] ?? '') . '" cannot be read'; $errs++; } elseif ($rent <= 0) { $msgs[] = "$name($l) Warning: the rent for $who is zero or negative"; $warn++; }
        if ($cD !== null && trim($c[$cD] ?? '') !== '') { $due = parse_date($c[$cD], $dmy);
            if ($due === null) { $msgs[] = "$name($l) Error: the due date \"" . $c[$cD] . '" cannot be read'; $errs++; }
            else { $k = $unit . '|' . $due; if (isset($seen[$k]) && $unit !== '') { $msgs[] = "$name($l) Warning: $who is listed twice for the rent due $due (line {$seen[$k]})"; $warn++; } else $seen[$k] = $l;
                $pv = $cP !== null ? trim($c[$cP] ?? '') : ''; $paid = false; $short = null;
                if ($pv !== '') { if (preg_match('/^(y|yes|paid|true|x|✓|✔|1|oui|payé|ja|bezahlt|si|sì|sí|pagado|pagato|sim|pago)$/iu', $pv)) $paid = true; elseif (preg_match('/^(n|no|nein|non|unpaid|false|0|-)$/iu', $pv)) $paid = false; elseif (parse_date($pv, $dmy) !== null && !preg_match('/^[\d.,]+$/', $pv)) $paid = true; else { $am = parse_num($pv); if ($am !== null && $rent !== null) { if ($am + 0.005 >= $rent) $paid = true; elseif ($am > 0) { $short = $rent - $am; } } } }
                if ($paid) $paidN++; elseif ($rent !== null) { $d = $days($due); $amt = $short ?? $rent; if ($short !== null) $partial[] = [$l, $who, $short, $cur]; if ($d < 0) { $over[] = [$l, $who, $due, -$d, $amt, $cur]; $msgs[] = "$name($l) Warning: rent for $who was due $due: " . (-$d) . ' day(s) overdue, ' . number_format($amt, 2) . ($cur !== '' ? " $cur" : '') . ($short !== null ? ' still owing (part paid)' : ''); $warn++; } elseif ($d <= $soon) { $up[] = [$l, $who, $due, $d, $amt, $cur]; $msgs[] = "$name($l) Note: rent for $who is due $due (" . ($d === 0 ? 'today' : "in $d day(s)") . ')'; } } } }
