    if ($cDep !== null) { $o .= "\n## Deposits held\n\n"; if ($dep) { $o .= "| Currency | Total | Units |\n|---|---|---|\n"; foreach ($dep as $c => $v) $o .= "| $c | " . number_format(array_sum($v), 2) . ' | ' . count($v) . " |\n"; $o .= "\nA tenancy listed on several rows is counted once (the last deposit shown for it).\n"; } else $o .= "None recorded.\n"; if ($nodep) $o .= "\nNo deposit recorded for: " . implode(', ', array_slice(array_unique($nodep), 0, 20)) . "\n"; }
