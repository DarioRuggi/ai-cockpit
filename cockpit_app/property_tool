    $cR = find_col($HX, ['rent', 'monthly rent', 'alquiler', 'loyer', 'miete', 'affitto', 'aluguel', 'renta']); $cD = find_col($H, ['due', 'due date', 'rent due', 'vencimiento', 'échéance', 'fällig', 'scadenza', 'vencimento']); $cP = find_col($H, ['paid', 'payment', 'received', 'pagado', 'payé', 'bezahlt', 'pagato', 'pago']);
    $cE = find_col($H, ['lease end', 'end date', 'expiry', 'expires', 'lease expiry', 'lease_end', 'fin de bail', 'mietende', 'scadenza contratto', 'fin', 'fim', 'vencimiento contrato']); $cDep = find_col($H, ['deposit', 'security deposit', 'depósito', 'depot', 'dépôt', 'kaution', 'caparra', 'caução', 'caución']); $cC = find_col($H, ['currency', 'moneda', 'devise', 'währung', 'valuta', 'moeda']);
    if ($cR === null) fail('no rent column found (rent, loyer, Miete, alquiler, affitto ...)'); if ($cD === null && $cE === null && $cDep === null) fail('no due, lease-end or deposit column found');
    $today = $opt['today'] ?? date('Y-m-d'); if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $today) || !checkdate((int)substr($today, 5, 2), (int)substr($today, 8, 2), (int)substr($today, 0, 4))) fail('today= must be a date like 2026-03-01');
    $soon = isset($opt['soon']) && ctype_digit($opt['soon']) ? (int)$opt['soon'] : 7; $within = isset($opt['within']) && ctype_digit($opt['within']) ? (int)$opt['within'] : 60;
