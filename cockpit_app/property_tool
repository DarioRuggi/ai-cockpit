if ($sub === 'calc') {
    $P = []; foreach (preg_split('/\n/', text_file($in)) as $ln) { $ln = trim($ln); if ($ln === '' || $ln[0] === '#') continue; if (preg_match('/^([A-Za-z_ ]{2,20})\s*[=:]\s*(.+)$/u', $ln, $m)) $P[strtolower(trim($m[1]))] = trim($m[2]); } $P = array_merge($P, $opt);
    $raw = fn(string $k) => $P[$k] ?? null; $num = function (string $k) use ($P): ?float { if (!isset($P[$k]) || $P[$k] === '') return null; $v = parse_num(rtrim($P[$k], '% ')); if ($v === null) fail("$k=\"{$P[$k]}\" is not a number"); if ($v < 0) fail("$k cannot be negative"); return $v; };
    $price = $num('price'); $rent = $num('rent'); if ($price === null || $price <= 0) fail('give price= (the purchase price), above zero'); if ($rent === null || $rent <= 0) fail('give rent= (the rent per month), above zero');
    $vac = $num('vacancy') ?? 0.0; $mgmt = $num('management') ?? 0.0; if ($vac > 100 || $mgmt > 100) fail('vacancy and management are percentages of the rent, at most 100'); $rate = $num('rate'); $years = $num('years'); if ($rate !== null && $rate > 100) fail('rate= is a yearly percentage, at most 100'); if ($years !== null && ($years <= 0 || $years > 60)) fail('years= must be between 0 and 60');
