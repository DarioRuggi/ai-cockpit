    $mod = '<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd"><script:module xmlns:script="http://openoffice.org/2000/script" script:name="' . $name . '" script:language="StarBasic">' . htmlspecialchars($src, ENT_XML1 | ENT_COMPAT, 'UTF-8') . '</script:module>';
