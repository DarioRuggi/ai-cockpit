        }
        $z->close(); return $res;
    }
    if (strncmp($head, "\xD0\xCF\x11\xE0", 4) === 0) { $mods = vba_extract((string)file_get_contents($path)); if ($mods) { $res['kind'] = 'vba'; foreach ($mods as $m) { $e = @mb_convert_encoding($m['source'], 'UTF-8', 'CP' . ($m['codepage'] ?? 1252)); $res['modules'][] = [$m['name'], $m['type'], $e === false ? $m['source'] : $e, 'VBA storage']; } } }
    return $res;
}
$AUTO = ['auto_open', 'auto_close', 'auto_exec', 'autoexec', 'autonew', 'autoexit', 'document_open', 'document_new', 'document_close', 'workbook_open', 'workbook_beforeclose', 'workbook_activate', 'worksheet_change', 'presentation_open', 'app_presentationopen'];
$RISK = ['Shell(' => 'runs a program', 'WScript.Shell' => 'runs a program (WScript)', 'CreateObject(' => 'COM object: files, Excel, the network', 'GetObject(' => 'COM object', 'URLDownloadToFile' => 'downloads a file', 'XMLHTTP' => 'network request', 'WinHttp' => 'network request', 'ADODB.Stream' => 'writes files', 'PowerShell' => 'runs PowerShell', 'cmd.exe' => 'runs the command prompt', 'Environ(' => 'reads environment variables', 'Kill ' => 'deletes files', 'RmDir' => 'deletes folders', 'FileCopy' => 'copies files', 'SendKeys' => 'sends keystrokes', 'RegWrite' => 'writes the registry', 'Declare ' => 'calls a Windows API (not portable)', 'Application.OnTime' => 'schedules itself'];
function macro_report(array $mi, string $name): string {
    global $AUTO, $RISK;
    if (!$mi['modules']) return "# Macros: $name\n\nNo macros found.\n";
    $o = "# Macros: $name\n\nKind: " . ($mi['kind'] === 'vba' ? 'VBA (Microsoft)' : 'LibreOffice Basic / Python') . '; ' . count($mi['modules']) . " module(s). The macros are only read here, never run.\n\n| Module | Type | Lines | Auto-run | Risky calls |\n|---|---|---|---|---|\n";
    foreach ($mi['modules'] as [$n, $t, $src]) {
        $low = strtolower($src); $auto = []; foreach ($AUTO as $a) if (preg_match('/\b(sub|function)\s+' . preg_quote($a, '/') . '\b/i', $src)) $auto[] = $a;
        $risk = []; foreach ($RISK as $k => $d) if (stripos($src, $k) !== false) $risk[] = rtrim($k, ' (') . ' (' . $d . ')';
        $o .= '| ' . $n . ' | ' . $t . ' | ' . (substr_count($src, "\n") + 1) . ' | ' . ($auto ? implode(', ', $auto) : '-') . ' | ' . ($risk ? implode('; ', $risk) : '-') . " |\n";
    }
    return $o;
}

// ---- macros / extract ------------------------------------------------------------------------------------------------------------------------
if ($sub === 'macros') { $mi = macro_info($in); file_put_contents($out, macro_report($mi, basename($in)) . "\n[exit code 0]\n"); echo 'Wrote ' . $out . ' (' . count($mi['modules']) . " modules)\n"; exit(0); }
if ($sub === 'extract') {
    $mi = macro_info($in); if (!$mi['modules']) fail('no macros found in ' . basename($in));
    $o = "' Macros of " . basename($in) . ' (' . ($mi['kind'] === 'vba' ? 'VBA' : 'Basic/Python') . ', ' . count($mi['modules']) . " module(s)), extracted as UTF-8 text. Read only: nothing here was run.\r\n";
    foreach ($mi['modules'] as [$n, $t, $src]) $o .= "\r\n' ============================================================\r\n' Module: $n   (type: $t)\r\n' ============================================================\r\n" . rtrim($src) . "\r\n";
    file_put_contents($out, $o); echo "Wrote $out (" . count($mi['modules']) . " modules)\n"; exit(0);
}

// ---- inject (ODF only) -----------------------------------------------------------------------------------------------------------------------
if ($sub === 'inject') {
    if (!in_array($ext, ['ods', 'odt', 'odp'], true)) fail('inject works on .ods / .odt / .odp (LibreOffice Basic runs there). For Microsoft files, convert to .ods/.odt first.');
    if ($oext !== $ext) fail("the output must be .$ext, like the input");
    $bas = $arg; if ($bas === '' || !is_file($bas)) fail('give the path of the .bas / .txt source file in the extra arguments');
    $src = (string)file_get_contents($bas); if (!mb_check_encoding($src, 'UTF-8')) $src = mb_convert_encoding($src, 'UTF-8', 'CP1252');
    $src = str_replace(["\r\n", "\r"], "\n", $src);
    $name = preg_replace('/[^A-Za-z0-9_]/', '', pathinfo($bas, PATHINFO_FILENAME)) ?: 'Module1'; if (!preg_match('/^[A-Za-z]/', $name)) $name = 'M' . $name;
    $vba = preg_match('/^\s*(Attribute\s+VB_Name|Option\s+VBASupport|Sub\s+(Auto_Open|Workbook_Open|Document_Open))/mi', $src) || preg_match('/\b(Dim|Set)\s+\w+\s+As\s+(Object|Worksheet|Workbook|Range|Document)\b/i', $src);
    $src = preg_replace('/^Attribute\s+VB_[^\n]*\n/mi', '', $src);
    if ($vba && !preg_match('/Option\s+VBASupport\s+1/i', $src)) $src = "Option VBASupport 1\n" . $src;
    copy($in, $out); $z = new ZipArchive(); if ($z->open($out) !== true) fail('not a readable OpenDocument file');
    $lc = $z->getFromName('Basic/script-lc.xml'); $lib = 'Standard';
    if ($lc === false) $lc = '<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE library:library-container PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "library-container.dtd"><library:libraries xmlns:library="http://openoffice.org/2000/library" xmlns:xlink="http://www.w3.org/1999/xlink"><library:library library:name="Standard" xlink:href="$(USER)/basic/Standard/script-lb.xml/" xlink:type="simple" library:link="false"/></library:libraries>';
    $lbPath = "Basic/$lib/script-lb.xml"; $lb = $z->getFromName($lbPath);
    if ($lb === false) $lb = '<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE library:library PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "library.dtd"><library:library xmlns:library="http://openoffice.org/2000/library" library:name="Standard" library:readonly="false" library:passwordprotected="false"></library:library>';
    $n0 = $name; $k = 2; while ($z->locateName("Basic/$lib/$name.xml") !== false) $name = $n0 . $k++;      // never replace a module that is there
