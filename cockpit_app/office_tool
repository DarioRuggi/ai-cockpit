    $add = ''; foreach (["Basic/script-lc.xml" => $z->getFromName('Basic/script-lc.xml') === false, $lbPath => $z->getFromName($lbPath) === false, "Basic/$lib/$name.xml" => true] as $p => $need) if ($need && strpos($mf, 'full-path="' . $p . '"') === false) $add .= '<manifest:file-entry manifest:full-path="' . $p . '" manifest:media-type="text/xml"/>';
