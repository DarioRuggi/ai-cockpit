#!/usr/bin/env php
<?php
// =============================================================================
// office_tool — the Document formats tools' work, for the tool presets (tools_builtins/office.json). A command-line program, never reachable over the web.
//
//   php office_tool convert FILE OUTPUT [drop-macros]   to the format of OUTPUT's extension; REFUSES (and writes nothing) if the source has macros and the
//                                                       result would lose them, unless "drop-macros" is given. Refuses a document -> spreadsheet kind of change.
//   php office_tool macros  FILE OUTPUT                 list the macros: modules, size, auto-run procedures, risky calls (Shell, CreateObject, downloads ...). Never runs them.
//   php office_tool extract FILE OUTPUT                 all the macro modules as one UTF-8 text file (with a header per module), for reading, porting and review
//   php office_tool inject  FILE OUTPUT SOURCE.bas      put the Basic/VBA source in as a module of an .ods/.odt/.odp (LibreOffice Basic, VBA mode), so it runs there
//   php office_tool inspect FILE OUTPUT                 what is inside: sheets, formulas, comments, tracked changes, pictures, macros, links, protection ...
//   php office_tool verify  FILE OUTPUT [ext]           convert to ext (default: the other family's usual one) and back, then compare the text / the cell values
//
// Reads Microsoft (doc docx docm xls xlsx xlsm ppt pptx pptm), OpenDocument and OpenOffice (odt ods odp sxw sxc sxi), RTF, CSV, Gnumeric, AbiWord, WordPerfect, Apple iWork
// through LibreOffice, in a throw-away profile with macro security at its maximum: a macro is never executed here. The original is never changed.
// =============================================================================
if (PHP_SAPI !== 'cli') { http_response_code(403); exit; }
require_once __DIR__ . '/lo_lib.php';
require_once __DIR__ . '/vba_lib.php';
function fail(string $m, int $rc = 1): void { fwrite(STDERR, "office_tool: $m\n"); exit($rc); }
[$sub, $in, $out, $arg] = [$argv[1] ?? '', $argv[2] ?? '', $argv[3] ?? '', $argv[4] ?? ''];
if (!in_array($sub, ['convert', 'macros', 'extract', 'inject', 'inspect', 'verify'], true) || $in === '' || $out === '') fail('usage: office_tool convert|macros|extract|inject|inspect|verify FILE OUTPUT [ARG]', 2);
if (!is_file($in)) fail("no such file: $in");
