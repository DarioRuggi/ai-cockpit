    echo "Wrote $out: the module $name (" . (substr_count($src, "\n") + 1) . " lines" . ($vba ? ', VBA mode: Option VBASupport 1' : '') . ") is in the library $lib. Macro security in LibreOffice decides whether it may run.\n"; exit(0);
}

// ---- inspect ---------------------------------------------------------------------------------------------------------------------------------
function zip_text(ZipArchive $z, string $n): string { $s = $z->getFromName($n); return $s === false ? '' : $s; }
function inspect_file(string $in, string $ext, array $mi): array {      // [label => value]
    $r = []; $z = new ZipArchive();
    if (!in_array($ext, ['docx', 'docm', 'dotx', 'xlsx', 'xlsm', 'xltx', 'pptx', 'pptm', 'ppsx', 'potx', 'odt', 'ods', 'odp', 'ott', 'ots'], true) || $z->open($in) !== true) return $r;
    $names = []; for ($i = 0; $i < $z->numFiles; $i++) $names[] = $z->getNameIndex($i);
    $cnt = fn(string $pre) => count(array_filter($names, fn($n) => strpos($n, $pre) === 0 && substr($n, -1) !== '/'));
    if (in_array($ext, ['docx', 'docm', 'dotx'], true)) {
        $d = zip_text($z, 'word/document.xml');
        $r['Words (approx)'] = preg_match_all('/<w:t[ >][^<]*|<w:t>[^<]*/', $d) ? str_word_count(strip_tags(preg_replace('/<\/w:p>/', ' ', $d))) : 0;
        $r['Paragraphs'] = substr_count($d, '<w:p>') + substr_count($d, '<w:p '); $r['Tables'] = substr_count($d, '<w:tbl>');
        $r['Tracked changes (insertions/deletions)'] = substr_count($d, '<w:ins ') . ' / ' . substr_count($d, '<w:del '); $r['Comments'] = substr_count(zip_text($z, 'word/comments.xml'), '<w:comment ');
        $r['Pictures'] = $cnt('word/media/'); $r['Embedded objects'] = $cnt('word/embeddings/'); $r['Fields'] = substr_count($d, '<w:fldSimple') + substr_count($d, '<w:instrText'); $r['Content controls'] = substr_count($d, '<w:sdt>');
        $r['Footnotes/endnotes'] = substr_count(zip_text($z, 'word/footnotes.xml'), '<w:footnote ') + substr_count(zip_text($z, 'word/endnotes.xml'), '<w:endnote ');
        $r['Editing restrictions'] = strpos(zip_text($z, 'word/settings.xml'), 'w:documentProtection') !== false ? 'yes' : 'no';
    } elseif (in_array($ext, ['xlsx', 'xlsm', 'xltx'], true)) {
        $wb = zip_text($z, 'xl/workbook.xml'); $f = 0; $cells = 0; $prot = 0; $cond = 0; $dv = 0; foreach ($names as $n) if (preg_match('~^xl/worksheets/sheet\d+\.xml$~', $n)) { $x = (string)$z->getFromName($n); $f += preg_match_all('/<f[ >\/]/', $x); $cells += preg_match_all('/<c /', $x); $prot += substr_count($x, '<sheetProtection'); $cond += substr_count($x, '<conditionalFormatting'); $dv += substr_count($x, '<dataValidation '); }
        $r['Sheets'] = substr_count($wb, '<sheet ') . (substr_count($wb, 'state="hidden"') + substr_count($wb, 'state="veryHidden"') ? ' (' . (substr_count($wb, 'state="hidden"') + substr_count($wb, 'state="veryHidden"')) . ' hidden)' : '');
        $r['Cells with content'] = $cells; $r['Formulas'] = $f; $r['Named ranges'] = substr_count($wb, '<definedName '); $r['Charts'] = $cnt('xl/charts/chart'); $r['Pivot tables'] = $cnt('xl/pivotTables/pivotTable');
        $r['Links to other workbooks'] = $cnt('xl/externalLinks/externalLink'); $r['Protected sheets'] = $prot; $r['Conditional formats'] = $cond; $r['Data validations'] = $dv; $r['Pictures'] = $cnt('xl/media/'); $r['Comments'] = $cnt('xl/comments');
    } elseif (in_array($ext, ['pptx', 'pptm', 'ppsx', 'potx'], true)) {
        $r['Slides'] = count(array_filter($names, fn($n) => preg_match('~^ppt/slides/slide\d+\.xml$~', $n))); $r['Notes pages'] = $cnt('ppt/notesSlides/notesSlide'); $r['Pictures/media'] = $cnt('ppt/media/'); $r['Embedded objects'] = $cnt('ppt/embeddings/');
        $anim = 0; $trans = 0; foreach ($names as $n) if (preg_match('~^ppt/slides/slide\d+\.xml$~', $n)) { $x = (string)$z->getFromName($n); $anim += substr_count($x, '<p:timing'); $trans += substr_count($x, '<p:transition'); } $r['Slides with animations'] = $anim; $r['Slides with transitions'] = $trans;
    } else {      // OpenDocument
        $c = zip_text($z, 'content.xml');
        $r['Tables/sheets'] = substr_count($c, '<table:table '); $r['Formulas'] = substr_count($c, 'table:formula='); $r['Pictures'] = substr_count($c, '<draw:image'); $r['Comments/annotations'] = substr_count($c, '<office:annotation ');
        $r['Tracked changes'] = substr_count($c, '<text:changed-region'); $r['Slides (pages)'] = substr_count($c, '<draw:page '); $r['Protected'] = strpos($c, 'table:protected="true"') !== false ? 'yes (a sheet)' : 'no'; $r['Charts/embedded objects'] = $cnt('Object ') + $cnt('Obj');
    }
    $enc = false; foreach ($names as $n) if ($n === 'EncryptionInfo' || $n === 'EncryptedPackage') $enc = true; if ($enc) $r['Password protected'] = 'yes (cannot be read)';
    $z->close(); return $r;
}
if ($sub === 'inspect') {
    $mi = macro_info($in); $o = "# Inside " . basename($in) . "\n\n"; $info = inspect_file($in, $ext, $mi); $legacy = false;
    if (!$info && in_array($ext, ['doc', 'xls', 'ppt', 'dot', 'xlt', 'pps', 'sxw', 'sxc', 'sxi', 'rtf', 'wpd', 'abw', 'pages', 'numbers', 'key', 'gnumeric', 'csv', 'tsv'], true)) {
        $to = ['text' => 'docx', 'sheet' => 'xlsx', 'slide' => 'pptx'][$fam($ext) ?? 'text']; $tmp = sys_get_temp_dir() . '/office_ins_' . getmypid() . '.' . $to;
        $e = lo_convert($in, $TO[$to][1], $tmp, 300);
        if ($e === null) { $info = inspect_file($tmp, $to, ['modules' => []]); $legacy = true; } @unlink($tmp);
    }
    $o .= 'Format: .' . $ext . ($fam($ext) ? ' (' . ['text' => 'text document', 'sheet' => 'spreadsheet', 'slide' => 'presentation'][$fam($ext)] . ')' : '') . '; ' . round(filesize($in) / 1024) . " KB\n";
    if ($legacy) $o .= "Older format: the counts below come from a temporary conversion by LibreOffice; macros are read from the original.\n";
    $o .= "\n| What | How many |\n|---|---|\n"; foreach ($info as $k => $v) $o .= "| $k | $v |\n";
    if (!$info) $o .= "| (no details for this format) | |\n";
    $o .= "\nMacros: " . ($mi['modules'] ? count($mi['modules']) . ' module(s), ' . ($mi['kind'] === 'vba' ? 'VBA' : 'Basic/Python') . ': ' . implode(', ', array_map(fn($m) => $m[0], $mi['modules'])) . ' (run Macros for the detail)' : 'none') . "\n";
    $risk = []; if (!empty($info['Tracked changes (insertions/deletions)']) && $info['Tracked changes (insertions/deletions)'] !== '0 / 0') $risk[] = 'tracked changes (may be accepted or lost by a conversion)';
    if (!empty($info['Links to other workbooks'])) $risk[] = 'links to other workbooks (the paths will break)'; if (!empty($info['Pivot tables'])) $risk[] = 'pivot tables (often changed)'; if ($mi['modules']) $risk[] = 'macros (VBA does not survive every conversion)';
    if (!empty($info['Protected sheets'])) $risk[] = 'protected sheets'; if (!empty($info['Content controls'])) $risk[] = 'content controls (forms)';
    $o .= $risk ? "\nAt risk in a conversion: " . implode('; ', $risk) . ".\n" : "\nNothing here is usually lost in a conversion.\n";
    file_put_contents($out, $o . "\n[exit code 0]\n"); echo "Wrote $out\n"; exit(0);
}

// ---- convert -----------------------------------------------------------------------------------------------------------------------------------
$sfam = $fam($ext); if ($sfam === null && $ext !== 'pdf') fail("not a document, spreadsheet or presentation LibreOffice reads (.$ext)");
if ($sub === 'convert') {
    if (!isset($TO[$oext])) fail("the output format .$oext is not supported (" . implode(' ', array_keys($TO)) . ')');
    [$tfam, $spec] = $TO[$oext];
    if ($tfam !== null && $sfam !== null && $tfam !== $sfam) fail("a " . ['text' => 'text document', 'sheet' => 'spreadsheet', 'slide' => 'presentation'][$sfam] . " (.$ext) cannot become a " . ['text' => 'text document', 'sheet' => 'spreadsheet', 'slide' => 'presentation'][$tfam] . " (.$oext): pick a format of the same kind");
    if ($ext === $oext) { copy($in, $out); echo "Already .$oext: copied.\n"; exit(0); }
    $src = macro_info($in); $drop = stripos($arg, 'drop-macros') !== false;
    $tmp = sys_get_temp_dir() . '/office_cv_' . getmypid() . '.' . $oext;
    if ($oext === 'gnumeric' || $ext === 'gnumeric') {      // Gnumeric's own converter, for the format LibreOffice only half knows
        if (!trim((string)shell_exec('command -v ssconvert 2>/dev/null'))) fail('ssconvert (gnumeric) is not installed (sudo apt install gnumeric)');
        $o = []; $rc = 0; exec('ssconvert ' . escapeshellarg($in) . ' ' . escapeshellarg($tmp) . ' 2>&1', $o, $rc); if ($rc !== 0 || !is_file($tmp)) fail('ssconvert failed: ' . trim(implode(' ', array_slice($o, -2))));
    } else { $e = lo_convert($in, $spec, $tmp, 600); if ($e) fail($e); }
    $dst = macro_info($tmp);
    if ($src['modules'] && count($dst['modules']) < count($src['modules']) && !$drop) {
        @unlink($tmp);
        $names = implode(', ', array_map(fn($m) => $m[0], $src['modules']));
        fail("REFUSED: the source has " . count($src['modules']) . " macro module(s) ($names) and the .$oext result would " . ($dst['modules'] ? 'keep only ' . count($dst['modules']) : 'have none') . ". Nothing was written.\n  Keep them: convert to " . ($sfam === 'sheet' ? '.xlsm, .xls or .ods' : ($sfam === 'text' ? '.docm or .odt' : '.pptm or .odp')) . " instead; or extract them first (Extract macros); or add drop-macros to the extra arguments to convert anyway.");
    }
    if (!@rename($tmp, $out)) { copy($tmp, $out); @unlink($tmp); }
    $msg = "Converted .$ext to .$oext: $out (" . round(filesize($out) / 1024) . ' KB)';
    if ($src['modules']) $msg .= "\nMACROS: the source has " . count($src['modules']) . ' module(s) (' . ($src['kind'] === 'vba' ? 'VBA' : 'Basic') . '); the result ' . (count($dst['modules']) >= count($src['modules']) ? ($dst['kind'] === 'basic' && $src['kind'] === 'vba' ? 'has them as LibreOffice Basic (Option VBASupport 1): review them in LibreOffice' : 'keeps them') : ($drop ? 'has NONE (dropped, as you asked)' : 'lost some'));
    echo $msg . "\n"; exit(0);
}

// ---- verify: there and back, then compare -------------------------------------------------------------------------------------------------------------
if ($sub === 'verify') {
    $t = strtolower(trim($arg)) ?: ['text' => 'odt', 'sheet' => 'ods', 'slide' => 'odp'][$sfam] ?? '';
    if (!isset($TO[$t])) fail("the format to go through must be one of: " . implode(' ', array_keys($TO)));
    if ($sfam === 'slide') fail('verify compares text and cell values: it is for documents and spreadsheets. For a presentation use the Presentations tool (outline).');
    if ($TO[$t][0] !== $sfam) fail("a .$ext cannot go through .$t (different kind)");
    $d = sys_get_temp_dir() . '/office_vf_' . getmypid(); @mkdir($d, 0700, true); $sm = macro_info($in);
    $mid = "$d/mid.$t"; $back = "$d/back.$ext";
    $e = lo_convert($in, $TO[$t][1], $mid, 600); if ($e) fail("there: $e");
    $e = isset($TO[$ext]) ? lo_convert($mid, $TO[$ext][1], $back, 600) : 'the way back to .' . $ext . ' is not a supported output'; if ($e) fail("back: $e");
    $textOf = function (string $f, string $tag) use ($sfam, $d): ?string {
        $o = "$d/$tag." . ($sfam === 'sheet' ? 'csv' : 'txt'); $e = lo_convert($f, $sfam === 'sheet' ? 'csv:Text - txt - csv (StarCalc):44,34,76,1' : 'txt:Text (encoded):UTF8', $o, 300);
        return $e ? null : (string)file_get_contents($o);
    };
    $a = $textOf($in, 'orig'); $b = $textOf($back, 'back'); $norm = fn($s) => trim(preg_replace('/[ \t\x{00A0}]+/u', ' ', preg_replace('/\r\n?/', "\n", (string)$s)));
    $same = $a !== null && $b !== null && $norm($a) === $norm($b);
    $di = $sfam === 'sheet' ? 'cells of the first sheet' : 'text'; $o = "# Round trip: .$ext -> .$t -> .$ext\n\n- Source: " . basename($in) . "\n- Compared: the $di, whitespace-normalised\n- Result: " . ($same ? "**identical**" : '**DIFFERENT**') . "\n";
    if (!$same && $a !== null && $b !== null) { $la = explode("\n", $norm($a)); $lb = explode("\n", $norm($b)); $n = 0; foreach ($la as $i => $line) { if (($lb[$i] ?? null) !== $line) { $o .= "\nFirst difference at line " . ($i + 1) . ":\n- before: " . mb_substr($line, 0, 160) . "\n- after:  " . mb_substr($lb[$i] ?? '(missing)', 0, 160) . "\n"; if (++$n >= 5) break; } } if (count($la) !== count($lb)) $o .= "\nLines before: " . count($la) . ", after: " . count($lb) . "\n"; }
    $bm = macro_info($back); $o .= "- Macros before: " . count($sm['modules']) . "; after the round trip: " . count($bm['modules']) . ($sm['modules'] && count($bm['modules']) < count($sm['modules']) ? " **LOST**" : '') . "\n";
    foreach (glob("$d/*") ?: [] as $f) @unlink($f); @rmdir($d);
    $bad = !$same || ($sm['modules'] && count($bm['modules']) < count($sm['modules']));
    file_put_contents($out, $o . "\n[exit code " . ($bad ? 1 : 0) . "]\n"); echo "Wrote $out (" . ($bad ? 'differences found' : 'identical') . ")\n"; exit(0);
}
