// ---- families and filters --------------------------------------------------------------------------------------------------------------------
$FAM = ['text' => ['doc', 'docx', 'docm', 'dot', 'dotx', 'dotm', 'odt', 'ott', 'fodt', 'sxw', 'stw', 'rtf', 'wpd', 'abw', 'zabw', 'pages', 'txt', 'html', 'htm', 'wps', 'lwp'],
        'sheet' => ['xls', 'xlsx', 'xlsm', 'xlsb', 'xlt', 'xltx', 'xltm', 'ods', 'ots', 'fods', 'sxc', 'stc', 'csv', 'tsv', 'gnumeric', 'gnm', 'numbers', 'wk1', 'wks', '123', 'dbf'],
        'slide' => ['ppt', 'pptx', 'pptm', 'pps', 'ppsx', 'pot', 'potx', 'odp', 'otp', 'fodp', 'sxi', 'sti', 'key']];
$fam = function (string $e) use ($FAM): ?string { foreach ($FAM as $f => $l) if (in_array($e, $l, true)) return $f; return null; };
// extension -> [family, LibreOffice target spec]; pdf takes any family
$TO = ['docx' => ['text', 'docx:MS Word 2007 XML'], 'docm' => ['text', 'docm:MS Word 2007 XML VBA'], 'doc' => ['text', 'doc:MS Word 97'], 'odt' => ['text', 'odt:writer8'], 'rtf' => ['text', 'rtf:Rich Text Format'],
       'txt' => ['text', 'txt:Text (encoded):UTF8'], 'html' => ['text', 'html:HTML (StarWriter)'], 'sxw' => ['text', 'sxw:StarOffice XML (Writer)'],
       'xlsx' => ['sheet', 'xlsx:Calc MS Excel 2007 XML'], 'xlsm' => ['sheet', 'xlsm:Calc MS Excel 2007 VBA XML'], 'xls' => ['sheet', 'xls:MS Excel 97'], 'ods' => ['sheet', 'ods:calc8'],
       'csv' => ['sheet', 'csv:Text - txt - csv (StarCalc):44,34,76,1'], 'sxc' => ['sheet', 'sxc:StarOffice XML (Calc)'], 'gnumeric' => ['sheet', 'gnumeric'],
       'pptx' => ['slide', 'pptx:Impress MS PowerPoint 2007 XML'], 'pptm' => ['slide', 'pptm:Impress MS PowerPoint 2007 XML VBA'], 'ppt' => ['slide', 'ppt:MS PowerPoint 97'], 'odp' => ['slide', 'odp:impress8'], 'sxi' => ['slide', 'sxi:StarOffice XML (Impress)'],
       'pdf' => [null, 'pdf']];

// ---- macros: found in whatever the file is (never executed) ------------------------------------------------------------------------------------
/** ['kind' => 'vba'|'basic'|'none', 'modules' => [[name, type, source (UTF-8), where]]] */
function macro_info(string $path): array {
    $res = ['kind' => 'none', 'modules' => []]; $head = (string)file_get_contents($path, false, null, 0, 8);
    $dec = function (string $src, int $cp): string { $enc = $cp ? 'CP' . $cp : 'CP1252'; $u = @mb_convert_encoding($src, 'UTF-8', $enc); return $u === false ? $src : $u; };
    if (strncmp($head, "PK", 2) === 0) {
        $z = new ZipArchive(); if ($z->open($path) !== true) return $res;
        for ($i = 0; $i < $z->numFiles; $i++) {
            $n = $z->getNameIndex($i);
            if (preg_match('~(^|/)vbaProject\.bin$~', $n)) { $mods = vba_extract((string)$z->getFromIndex($i)); foreach ((array)$mods as $m) { $res['modules'][] = [$m['name'], $m['type'], $dec($m['source'], $m['codepage'] ?? 1252), $n]; } if ($mods !== null) $res['kind'] = 'vba'; }
            elseif (preg_match('~^Basic/[^/]+/(?!script-l)[^/]+\.xml$~', $n)) { $x = (string)$z->getFromIndex($i); if (preg_match('~<script:module[^>]*script:name="([^"]*)"[^>]*>(.*)</script:module>~s', $x, $m)) { $res['modules'][] = [html_entity_decode($m[1]), 'basic', html_entity_decode($m[2], ENT_QUOTES | ENT_XML1), $n]; if ($res['kind'] === 'none') $res['kind'] = 'basic'; } }
