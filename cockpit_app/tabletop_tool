}
// ---- initiative --------------------------------------------------------------------------------------------------------------------------------
function csv_rows(string $f): array { $t = readtext($f); if (trim($t) === '') fail(basename($f) . ' is empty'); $first = strtok($t, "\n"); $c = ["\t" => substr_count($first, "\t"), ';' => substr_count($first, ';'), ',' => substr_count($first, ',')]; arsort($c); $sep = array_key_first($c);
    $h = fopen('php://memory', 'r+'); fwrite($h, $t); rewind($h); $ln = 0; $hdr = null; $rows = []; while (($r = fgetcsv($h, 0, $sep, '"', '')) !== false) { $ln++; if ($r === [null] || (count($r) === 1 && trim((string)$r[0]) === '')) continue; if ($hdr === null) { $hdr = array_map('ascii', $r); continue; } $rows[] = ['line' => $ln, 'c' => $r]; } return [$hdr ?? [], $rows]; }
function col(array $hdr, array $names): ?int { foreach ($hdr as $i => $h) if (in_array($h, $names, true)) return $i; return null; }
if ($sub === 'initiative') {
