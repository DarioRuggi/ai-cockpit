        if ($target !== null) { $ge = 0; foreach ($dist as $v => $p) if ($v >= $target) $ge += $p; $o .= " Chance of $target or more: " . sprintf('%.2f%%', $ge * 100) . '.'; }
        $o .= "\n\n"; if (count($dist) > 80) { $o .= "(" . count($dist) . " different totals: showing those with at least 0.1% chance)\n\n"; } $o .= "| Total | Chance | At least |\n|---:|---:|---:|\n"; $rem = 1.0; foreach ($dist as $v => $p) { $ge = $rem; $rem -= $p; if (count($dist) > 80 && $p < 0.001) continue; $o .= "| $v | " . sprintf('%.2f%%', $p * 100) . ' | ' . sprintf('%.2f%%', max($ge, 0) * 100) . " |\n"; } }
