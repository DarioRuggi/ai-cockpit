    if ($re !== $e || !$terms) throw new Exception("could not read \"$e\" as dice notation (examples: 2d6+3, 4d6kh3, 2d20kl1, d100)");
    return $terms; }
function roll_term(array $t): array { if (count($t) === 2) return [$t[0] * $t[1], [], [], (string)($t[0] * $t[1])]; [$sg, $n, $s, $mode, $k] = $t; $d = []; for ($i = 0; $i < $n; $i++) $d[] = mt_rand(1, $s); $kept = $d;
    if ($mode !== null) { $o = $d; sort($o); $kept = match ($mode) { 'kh' => array_slice($o, $n - $k), 'kl' => array_slice($o, 0, $k), 'dh' => array_slice($o, 0, $n - $k), 'dl' => array_slice($o, $k) }; }
