    $o = ($sub === 'roll' ? "# Dice rolls from $name\n\nSeed $seed (use seed=$seed to repeat these exact rolls).\n" : "# Probability tables from $name\n\nExact unless marked sampled. Probabilities are per roll of the expression.\n");
