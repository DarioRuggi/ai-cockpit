        if (isset($seen[ascii($nm)])) $msgs[] = "$name({$r['line']}) Warning: $nm appears twice (line " . $seen[ascii($nm)] . ')'; else $seen[ascii($nm)] = $r['line'];
        for ($i = 1; $i <= $cnt; $i++) { $roll = mt_rand(1, $die); $list[] = ['n' => $cnt > 1 ? "$nm $i" : $nm, 'roll' => $roll, 'bonus' => $bonus, 'total' => $roll + $bonus, 'hp' => $hp, 'ac' => $cac !== null ? trim((string)($r['c'][$cac] ?? '')) : '', 'team' => $ct !== null ? trim((string)($r['c'][$ct] ?? '')) : '']; } }
