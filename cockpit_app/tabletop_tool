        $sign = $x[1] === '-' ? -1 : 1; $n = $x[2] === '' ? 1 : (int)$x[2]; $s = (int)$x[3]; $mode = ($x[4] ?? '') === '' ? null : ($x[4] === 'k' ? 'kh' : $x[4]); $k = ($x[5] ?? '') === '' ? 0 : (int)$x[5];
        if ($n < 1 || $n > 1000) throw new Exception("number of dice must be 1-1000 in \"{$x[0]}\""); if ($s < 2 || $s > 1000000) throw new Exception("sides must be 2-1000000 in \"{$x[0]}\""); if ($mode !== null && ($k < 1 || $k >= $n + ($mode[0] === 'k' ? 1 : 0) || ($mode[0] === 'd' && $k >= $n))) throw new Exception("cannot " . ($mode[0] === 'k' ? 'keep' : 'drop') . " $k of $n dice in \"{$x[0]}\"");
