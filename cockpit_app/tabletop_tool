        if ($sub === 'roll') { $o .= "\n## $e\n\n"; for ($t = 1; $t <= $times; $t++) { $tot = 0; $parts = []; foreach ($terms as $term) { [$sum, $d, $kept, $txt] = roll_term($term); $tot += $sum; if (count($term) === 2) { $parts[] = ($term[0] < 0 ? '-' : '+') . abs($term[1]); continue; }
                $disp = array_map(fn($v) => (string)$v, $d); if ($term[3] !== null) { $left = $kept; $disp = []; foreach ($d as $v) { $i = array_search($v, $left, true); if ($i !== false) { unset($left[$i]); $disp[] = (string)$v; } else $disp[] = "~~$v~~"; } } $parts[] = $txt . ' [' . implode(', ', $disp) . ']=' . $sum; }
                $o .= ($times > 1 ? "$t. " : '') . '**' . $tot . '**  (' . implode(' ', $parts) . ")\n\n"; } continue; }
        $sampled = 0; $dist = [[0 => 1.0]]; $dist = [0 => 1.0]; $minv = 0; $maxv = 0;
