    elseif (pow($s, $n) <= 2000000) { $idx = array_fill(0, $n, 1); $total = pow($s, $n); $cnt = [];
        for ($c = 0; $c < $total; $c++) { $o = $idx; sort($o); $kept = match ($mode) { 'kh' => array_slice($o, $n - $k), 'kl' => array_slice($o, 0, $k), 'dh' => array_slice($o, 0, $n - $k), 'dl' => array_slice($o, $k) }; $v = array_sum($kept); $cnt[$v] = ($cnt[$v] ?? 0) + 1;
            for ($j = 0; $j < $n; $j++) { if (++$idx[$j] <= $s) break; $idx[$j] = 1; } } foreach ($cnt as $v => $c) $dist[$v] = $c / $total; }
    else { $sampled = 200000; mt_srand($seed); $cnt = []; for ($i = 0; $i < 200000; $i++) { [$v] = roll_term([1, $n, $s, $mode, $k]); $cnt[$v] = ($cnt[$v] ?? 0) + 1; } foreach ($cnt as $v => $c) $dist[$v] = $c / 200000; }
