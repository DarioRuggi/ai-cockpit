        if ($bonus === null) { $msgs[] = "$name({$r['line']}) Error: initiative bonus \"$bn\" of $nm is not a whole number"; continue; } if ($bn === '' && $cb !== null) $msgs[] = "$name({$r['line']}) Note: $nm has no initiative bonus: used 0";
