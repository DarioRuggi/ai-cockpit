        if ($min !== null && $v < $min) $msgs[] = "$name({$lns[$a]}) Error: $a $v is below the minimum $min"; if ($max !== null && $v > $max) $msgs[] = "$name({$lns[$a]}) Error: $a $v is above the maximum $max"; }
