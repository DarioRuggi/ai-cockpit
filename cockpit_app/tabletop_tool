    if (!$fields) fail("$name has no \"Field: value\" lines"); $req = isset($opt['require']) ? array_map('ascii', explode(',', $opt['require'])) : ['name', 'class', 'level']; $ab = isset($opt['abilities']) ? array_map('ascii', explode(',', $opt['abilities'])) : []; $msgs = [];
