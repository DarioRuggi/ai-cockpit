[$sub, $in, $out] = [$argv[1] ?? '', $argv[2] ?? '', $argv[3] ?? ''];
$args = array_slice($argv, 4);
if (!in_array($sub, ['roll', 'odds', 'initiative', 'sheet', 'notes'], true) || $in === '' || $out === '') fail('usage: tabletop_tool roll|odds|initiative|sheet|notes INPUT OUTPUT [key=value ...]', 2);
$opt = []; foreach ($args as $a) foreach (preg_split('/\s+(?=\w+=)/', trim($a)) as $p) if (strpos($p, '=') !== false) { [$k, $v] = explode('=', $p, 2); $opt[strtolower(trim($k))] = trim($v); }
if (!file_exists($in)) fail("no such file: $in"); $name = basename($in);
function ascii(string $s): string { $s = mb_strtolower(trim($s)); $t = function_exists('iconv') ? @iconv('UTF-8', 'ASCII//TRANSLIT//IGNORE', $s) : false; $s = ($t !== false && $t !== '') ? $t : $s; return trim(preg_replace('/[^a-z0-9]+/', ' ', $s)); }
