    foreach ($msgs as $m) $o .= "$m\n"; if (!$msgs) $o .= "No problems found.\n"; $o .= "\n" . count($msgs) . " finding(s), $e error(s). The rules are the ones you passed in; this does not know any game system.\n"; file_put_contents($out, $o); echo "Wrote $out ($e errors)\n"; exit(0);
}
// ---- notes -------------------------------------------------------------------------------------------------------------------------------------
$files = []; if (is_dir($in)) { foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($in, FilesystemIterator::SKIP_DOTS)) as $f) if (preg_match('/\.(md|txt|markdown)$/i', $f->getFilename())) $files[] = $f->getPathname(); sort($files); } else $files = [$in];
if (!$files) fail("no .md or .txt notes in $in"); $ents = []; $auto = false;
if (isset($opt['with'])) { if (!is_file($opt['with'])) fail('no such entity file: ' . $opt['with']); [$hd, $rows] = csv_rows($opt['with']); $cn = col($hd, ['name', 'nom', 'nome', 'nombre']); $ct = col($hd, ['type', 'kind', 'category', 'typ', 'tipo']); $ca = col($hd, ['aliases', 'alias', 'also', 'aka']); if ($cn === null) fail('the entity file needs a name column');
    foreach ($rows as $r) { $nm = trim((string)($r['c'][$cn] ?? '')); if ($nm === '') continue; $al = $ca !== null ? array_filter(array_map('trim', explode('|', (string)($r['c'][$ca] ?? '')))) : []; $ents[$nm] = ['type' => $ct !== null ? trim((string)($r['c'][$ct] ?? '')) : '', 'names' => array_merge([$nm], $al), 'hits' => []]; } }
$texts = []; foreach ($files as $f) { $texts[$f] = explode("\n", readtext($f)); }
if (!$ents) { $auto = true; foreach ($texts as $f => $ls) foreach ($ls as $l) if (preg_match_all('/\*\*([^*]{2,40})\*\*/u', $l, $mm)) foreach ($mm[1] as $b) $ents[trim($b)] ??= ['type' => '', 'names' => [trim($b)], 'hits' => []]; if (!$ents) fail('no entities: give with=ENTITIES.csv (name, type, aliases) or mark names in **bold** in the notes'); }
foreach ($texts as $f => $ls) { $sec = ''; foreach ($ls as $i => $l) { if (preg_match('/^\s{0,3}#{1,6}\s+(.*)$/', $l, $m)) $sec = trim($m[1]); $al = ' ' . ascii($l) . ' ';
    foreach ($ents as $en => &$e) foreach ($e['names'] as $n) { $nn = ascii($n); if ($nn !== '' && strpos($al, ' ' . $nn . ' ') !== false) { $e['hits'][] = [basename($f) . ':' . ($i + 1), $sec]; break; } } unset($e); } }
$o = "# Notes index of " . ($files[0] === $in ? $name : "$name (" . count($files) . " files)") . "\n\n" . ($auto ? "No entity list given: the names are the terms written in **bold** (candidates; pass with=ENTITIES.csv for a typed index). " : '') . "A mention is a whole-word match of the name or an alias, ignoring case and accents, so a common word used as a name will over-count.\n"; $none = []; $by = [];
