    if ($wc > 900) $add('Warning', 1, "about $wc words: more than roughly two pages; most readers want it shorter"); elseif ($wc < 150) $add('Note', 1, "only $wc words: short; add concrete results if you have them");
    $WEAK = ['responsible for','duties included','duties were','helped with','helped to','worked on','was involved in','assisted with','assisted in','participated in','tried to','various tasks','handled','responsable de','chargé de','en charge de','participé à','verantwortlich für','zuständig für','beteiligt an','mitgearbeitet','incaricato di','responsabile di','occupato di','responsável por','encarregado de','encargado de','a cargo de'];
    foreach ($lines as $i => $l) { $ll = mb_strtolower($l); foreach ($WEAK as $w) if (mb_strpos($ll, $w) !== false) { $add('Warning', $i + 1, "weak phrase \"$w\": say what you did and what came of it, if true"); break; }
        if (preg_match('/\b(?:was|were|been|being)\s+(?:\w+ly\s+)?(\w+ed|built|made|given|taken|done|led|run|written|chosen)\s+by\b/iu', $l, $m)) $add('Warning', $i + 1, "passive phrasing (\"" . trim($m[0]) . "\"): use an active verb"); }
