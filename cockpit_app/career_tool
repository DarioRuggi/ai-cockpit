#!/usr/bin/env php
<?php
// =============================================================================
// career_tool — the Job search and CV tools' work, for the tool presets (tools_builtins/career.json). A command-line program, never reachable over the web.
//
//   php career_tool cv        CV.md|txt   OUTPUT                  CV check: date gaps and overlaps in the experience list, mixed date formats, length, weak or passive phrasing, missing contact details
//   php career_tool match     CV.md|txt   OUTPUT AD.txt           the job ad's terms against the CV: found and missing. It NEVER adds a skill: a missing term is only a prompt to ask "do I really have this?"
//   php career_tool tracker   TRACKER.csv OUTPUT [today=YYYY-MM-DD]  applications: follow-ups due, status counts, response rate (columns found by name: company, role, applied, status, follow-up)
//   php career_tool questions AD.txt      OUTPUT                  an interview-practice question bank from the ad's requirements, with empty answer fields for TRUE examples
//
// Reading and counting aids; they never write a CV. The original is never changed. Problems come back as file(line) Error|Warning|Note: ...
// =============================================================================
if (PHP_SAPI !== 'cli') { http_response_code(403); exit; }
function fail(string $m, int $rc = 1): void { fwrite(STDERR, "career_tool: $m\n"); exit($rc); }
[$sub, $in, $out] = [$argv[1] ?? '', $argv[2] ?? '', $argv[3] ?? '']; $args = array_slice($argv, 4);
if (!in_array($sub, ['cv', 'match', 'tracker', 'questions'], true) || $in === '' || $out === '') fail('usage: career_tool cv|match|tracker|questions INPUT OUTPUT [AD.txt | today=YYYY-MM-DD]', 2);
function load(string $f): string { if (!is_file($f)) fail("no such file: $f"); $r = (string)file_get_contents($f); if (strncmp($r, "\xEF\xBB\xBF", 3) === 0) $r = substr($r, 3); if (!mb_check_encoding($r, 'UTF-8')) fail("not valid UTF-8: $f"); $r = str_replace(["\r\n", "\r"], "\n", $r); if (trim($r) === '') fail("the file is empty: $f"); return $r; }
$raw = load($in); $name = basename($in); $opt = []; foreach ($args as $a) if (preg_match('/^(\w+)=(.*)$/', trim($a), $m)) $opt[strtolower($m[1])] = trim($m[2]);
$msgs = []; $nerr = 0; $nwarn = 0;
$add = function (string $k, int $l, string $m) use (&$msgs, &$nerr, &$nwarn, $name) { $msgs[] = "$name($l) $k: $m"; if ($k === 'Error') $nerr++; elseif ($k === 'Warning') $nwarn++; };
function finish(string $out, string $body, array $msgs, int $nerr, int $nwarn): void {
