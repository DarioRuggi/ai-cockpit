        if ($b[0] < $a[0]) { $add('Error', $ln, 'the end (' . trim($m[2]) . ') is before the start (' . trim($m[1]) . ')'); continue; }
        $ranges[] = ['line' => $ln, 's' => $a[0], 'e' => $b[0], 'text' => trim(mb_substr($l, 0, 70))]; foreach ([$a, $b] as $x) if ($x[1] !== 'present') $fmts[$x[1]][] = $ln; }
