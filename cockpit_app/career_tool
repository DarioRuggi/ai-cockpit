    $h = fopen('php://temp', 'r+'); fwrite($h, $raw); rewind($h); $hd = null; $rows = []; $ln = 0;
    while (($r = fgetcsv($h, 0, $sep, '"', '')) !== false) { $ln++; if ($r === [null]) continue; $r = array_map(fn($x) => trim((string)$x), $r); if ($hd === null) { $hd = array_map('mb_strtolower', $r); continue; } $rows[] = [$ln, $r]; }
    $col = function (array $names) use ($hd) { foreach ($hd as $i => $x) foreach ($names as $n) if (mb_strpos($x, $n) !== false) return $i; return null; };
    $ci = $col(['company', 'employer', 'entreprise', 'unternehmen', 'azienda', 'empresa']); $ri = $col(['role', 'position', 'title', 'poste', 'stelle', 'ruolo', 'puesto', 'cargo']); $di = $col(['applied', 'date', 'sent', 'postul', 'bewerb', 'candidat']); $si = $col(['status', 'statut', 'stato', 'estado']); $fi = $col(['follow', 'next', 'relance', 'nachfass', 'seguimiento', 'sollecito']);
    if ($ci === null || $si === null) fail('the tracker needs a company column and a status column (found: ' . implode(', ', $hd) . ')');
    $today = $opt['today'] ?? date('Y-m-d'); if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $today) || !checkdate((int)substr($today, 5, 2), (int)substr($today, 8, 2), (int)substr($today, 0, 4))) fail("today must be a date YYYY-MM-DD, not $today", 2);
    $pd = function (string $s) { if (preg_match('/^(\d{4})-(\d{1,2})-(\d{1,2})$/', $s, $m) && checkdate((int)$m[2], (int)$m[3], (int)$m[1])) return sprintf('%04d-%02d-%02d', $m[1], $m[2], $m[3]); if (preg_match('/^(\d{1,2})[\/.](\d{1,2})[\/.](\d{4})$/', $s, $m) && checkdate((int)$m[2], (int)$m[1], (int)$m[3])) return sprintf('%04d-%02d-%02d', $m[3], $m[2], $m[1]); return null; };
    $days = fn(string $a, string $b) => (int)round((strtotime($b . ' UTC') - strtotime($a . ' UTC')) / 86400);
    $NOREPLY = '/^(applied|sent|submitted|waiting|no reply|no response|ghosted|postul[ée]?|envoy[ée]|gesendet|beworben|inviata|inviato|enviada|enviado|aplicado)$/iu'; $CLOSED = '/^(rejected|declined|withdrawn|closed|refus[ée]|abgelehnt|rifiutat[oa]|rechazad[oa]|rejeitad[oa]|retir[ée]|no thanks)$/iu';
    $cnt = []; $resp = 0; $tot = 0; $due = []; $o = "# Application tracker: $name\n\nToday: $today. A follow-up is due when the follow-up date has come, or, with no follow-up date and no reply, 10 days after applying.\n\n";
