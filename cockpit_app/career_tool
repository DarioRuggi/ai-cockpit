        if (preg_match('/^([A-Za-zäéûÄ]{3,9})\.?\s+(\d{4})$/u', $s, $m)) { $k = mb_strtolower(mb_substr($m[1], 0, 3)); if (!isset($MON[$k])) return null; return [(int)$m[2] * 12 + $MON[$k], 'Mon YYYY']; }
