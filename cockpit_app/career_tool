        if ($fu) { if ($fu <= $today) $due[] = [$l, $co, $c[$ri] ?? '', "follow-up date $fu" . ($fu < $today ? ' (' . $days($fu, $today) . ' days ago)' : ' (today)')]; }
        elseif ($ap && preg_match($NOREPLY, $stt) && $days($ap, $today) >= 10) $due[] = [$l, $co, $c[$ri] ?? '', 'applied ' . $days($ap, $today) . ' days ago, no reply and no follow-up date']; }
