        if (preg_match('/^(\d{4})-(\d{1,2})$/', $s, $m) && $m[2] >= 1 && $m[2] <= 12) return [(int)$m[1] * 12 + (int)$m[2], 'YYYY-MM'];
        if (preg_match('/^(\d{4})$/', $s, $m) && $m[1] >= 1950 && $m[1] <= 2100) return [(int)$m[1] * 12 + ($end ? 12 : 1), 'YYYY']; return null; };
    $lines = explode("\n", $raw); $ranges = []; $fmts = [];
