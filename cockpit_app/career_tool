    if (count($fmts) > 1) { $o .= '- Date formats in use: ' . implode(', ', array_keys($fmts)) . "\n"; $first = null; foreach ($fmts as $f => $ls) { $first ??= $f; } uasort($fmts, fn($x, $y) => count($y) <=> count($x)); $main = array_key_first($fmts);
        foreach ($fmts as $f => $ls) if ($f !== $main) foreach (array_unique($ls) as $ln) $add('Warning', $ln, "date written as $f while most are $main: use one format throughout"); }
