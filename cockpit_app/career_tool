        $tot++; $k = mb_strtolower($stt); $cnt[$k] = ($cnt[$k] ?? 0) + 1; if (!preg_match($NOREPLY, $stt) && $stt !== '(none)') $resp++;
        $ap = $di !== null ? $pd($c[$di] ?? '') : null; if ($di !== null && ($c[$di] ?? '') !== '' && !$ap) $add('Error', $l, 'the date "' . $c[$di] . '" cannot be read (use YYYY-MM-DD or DD/MM/YYYY)'); if ($ap && $ap > $today) $add('Warning', $l, "the application date $ap is in the future");
        if (preg_match($CLOSED, $stt) || preg_match('/^(offer|accepted|hired|oferta|angebot|offerta|accepted)$/iu', $stt)) continue;
